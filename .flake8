[flake8]
# Flake8 configuration for code quality checks

max-line-length = 100
max-complexity = 10

# Exclude patterns
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .hypothesis,
    venv,
    *.egg-info,
    build,
    dist,
    reports

# Ignore specific errors
ignore =
    E203,  # Whitespace before ':'
    E501,  # Line too long (handled by max-line-length)
    W503,  # Line break before binary operator
    W504,  # Line break after binary operator

# Per-file ignores
per-file-ignores =
    __init__.py:F401
    conftest.py:E402

# Enable specific warnings
select = E,W,F,C

# Count errors
count = True
statistics = True
